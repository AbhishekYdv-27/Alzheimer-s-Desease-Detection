# Environment Configuration
# Copy this file to .env and fill in the values

APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database. For Render, set this to a file on an attached persistent disk.
ALZHEIMERS_DB_PATH=./data/app.db
MODEL_CHECKPOINT_PATH=backend/models/resnet50_best.pth
MODEL_CHECKPOINT_SHA256=
MODEL_ARTIFACT_URL=
MODEL_ARTIFACT_TOKEN=
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000

# Authentication
# Use a long random value in local and production environments.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
