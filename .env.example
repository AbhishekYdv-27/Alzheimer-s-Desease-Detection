# Environment Configuration
# Copy this file to .env and fill in the values

APP_NAME=Alzheimer's AI Platform
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# API
API_PREFIX=/api
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Paths
DATA_DIR=./data
MODELS_DIR=./models
EXPERIMENTS_DIR=./experiments
REPORTS_DIR=./reports

# Database. SQLite is suitable for local development; use managed PostgreSQL
# and a database adapter before production multi-worker use.
DATABASE_URL=sqlite:///./data/app.db

# Authentication
# Use a long random value in local and production environments.
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
